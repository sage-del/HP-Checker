# サイト健診の環境変数
#
# 使い方: このファイルを .env.local にコピーして、使いたい機能の値を入れる。
#   cp .env.example .env.local
#
# 診断（/）は、何も設定しなくても動きます（外部 API は呼びません）。
# 値はすべてサーバー側でのみ読み、ブラウザには渡しません（NEXT_PUBLIC_ の付いたものを除く）。

# ── クロール ───────────────────────────────────────────────────
# 「サイト全体」で取得するページ数の上限（既定・上限とも 100。これより小さい値だけ指定できる）
# SITE_MAX_PAGES=100

# ── 表示 ───────────────────────────────────────────────────────
# フッターのバージョン表記（省略時は package.json の version）
# NEXT_PUBLIC_APP_VERSION=

# レポート末尾の「次のステップ」に出す連絡先（運営元のもの。両方無ければブロックごと非表示）
# NEXT_PUBLIC_CONTACT_NAME=
# NEXT_PUBLIC_CONTACT_URL=

# ── 定期監視（/monitor） ───────────────────────────────────────
# 診断結果を保存する Postgres の接続文字列（Neon / Supabase / Vercel Postgres など）。
# 未設定なら監視機能は出ず、これまで通りの無料診断だけが動く。テーブルは初回に自動で作る。
# DATABASE_URL=postgres://user:password@host:5432/dbname

# サイト全体の Basic 認証。監視機能を本番で使うときは必須（未設定だと /monitor は 503）。
# BASIC_AUTH_USER=admin
# BASIC_AUTH_PASSWORD=

# Vercel Cron が /api/cron/monitor を呼ぶときの合言葉（Vercel が自動で Authorization に付ける）。
# 本番で未設定だと定期診断は動かない。十分に長いランダムな文字列にする。
# CRON_SECRET=

# ── 開発用 ─────────────────────────────────────────────────────
# localhost や LAN 内のサイトを診断したいときだけ 1 にする（本番では絶対に設定しない）
# ALLOW_PRIVATE_HOSTS=1
